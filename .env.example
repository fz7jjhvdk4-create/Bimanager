# PostgreSQL-anslutning (krävs)
# Skapa en gratis PostgreSQL-databas via t.ex. Vercel Postgres, Neon (neon.tech) eller Supabase
# Exempel: postgresql://user:password@host:5432/bimanager
DATABASE_URL="postgresql://user:password@host:5432/bimanager"

# NextAuth.js (krävs för autentisering)
# Generera en hemlig nyckel med: openssl rand -base64 32
NEXTAUTH_SECRET="din-hemliga-nyckel-har"
# URL till din app (viktigt för produktion)
NEXTAUTH_URL="http://localhost:3000"
